rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nortje.curro@gmail.com' ||
        request.auth.uid == '69sU2DhbtLRNTULDKIawgLC1Om33' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'ADMIN' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    // 1. Users
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Settings - USE RECURSIVE WILDCARD AT ROOT OF COLLECTION
    match /settings/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Other Collections
    match /venues/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /sessions/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /assignments/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /leaveRequests/{id} { 
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.teacherId == request.auth.uid);
    }
    match /timetableEntries/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /markingExtensions/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /timetableLocks/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /dayPeriodConfigs/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /helpRequests/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
  }
}
